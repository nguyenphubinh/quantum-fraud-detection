# pyenv
#   For a library or package, you might want to ignore these files since the situation may
#   differ from user to user/system to system.
# .python-version

# pipenv
#   According to pypa/pipenv#1263, we should specify the Pipfile.lock.
#   However, in case of a library/package, we may want to ship the lock file.
#   But for apps, we definitely want to ship the lock file.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock contains the exact dependency versions.
# poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock contains the exact dependency versions.
# pdm.lock

# PEP 582; used by e.g. github.com/lincolnloop/layman and pdm
__pypackages__/

